Windows Registry Editor Version 5.00

; Add PowerShell context menu entries for .ps1 files
; Compatible with Windows 10 and Windows 11
;
; Non-admin: modifies the existing Windows.PowerShell.Run key which is already
; visible in the context menu - just changes its label and command.
; Admin: uses the runas canonical verb key.
;
; NOTE - Windows 11: entries may appear under "Show more options" unless you
; also merge Add-PS1-ContextMenu-Win11LegacyMenu.reg

; Clean up stale entries from previous attempts
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\run]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\run (admin)]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\RunPS]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\RunWithPowerShell]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\RunWithPS]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Microsoft.PowerShellScript.1\Shell\RunPS]

; "run with ps" - modifies the already-visible Windows.PowerShell.Run entry
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\Windows.PowerShell.Run]
"MUIVerb"="run with ps"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\Windows.PowerShell.Run\Command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File \"%1\""

; "run with ps (admin)" - runas canonical verb, always shown
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\runas]
@="run with ps (admin)"
"HasLUAShield"=""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\.ps1\Shell\runas\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%1\""
